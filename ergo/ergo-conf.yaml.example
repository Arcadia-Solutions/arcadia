# Ergo config for Arcadia.
#
# Copy to ergo-conf.yaml and change the settings marked with CHANGE below.
# Everything else is already tuned for Arcadia's setup.
#
# Secrets injected via environment (set in .env, applied by compose.yml):
#   ERGO__DATASTORE__MYSQL__*           MySQL credentials for persistent history
#   ERGO__API__BEARER_TOKENS            Token the Arcadia backend uses to call the Ergo HTTP API
#   ARCADIA_ERGO__AUTH_CALLBACK_TOKEN   Token Ergo sends to the backend when authenticating users
# These must match the `ergo` section of Arcadia's config.yml. or applied as the relevant environment config overrides for the backend
#
# there are more settings and features available in ergo. see https://github.com/ergochat/ergo/blob/master/default.yaml for details

# CHANGE: human-readable name for the network (no spaces)
network:
  name: Arcadia

server:
  # CHANGE: use your actual domain name
  name: irc.arcadia.local

  listeners:
    ":6667": # Plain IRC — TLS terminated at the reverse proxy
    ":8097":
      websocket: true # KiwiIRC webchat

  websockets:
    # CHANGE: add your Arcadia frontend origin to allow the embedded KiwiIRC webchat.
    # An empty list means no restriction (fine for local / trusted setups).
    allowed-origins:
      # - "https://your-arcadia-domain.com"

  motd: ergo.motd

  # IPs/CIDRs allowed to use the PROXY command (keep restricted to localhost)
  proxy-allowed-from:
    - localhost

# account options
accounts:
  authentication-enabled: true

  registration:
    # Disabled: Arcadia provisions IRC accounts itself via the HTTP API.
    # Admins can still create accounts with /NICKSERV SAREGISTER.
    enabled: false

  login-throttling:
    enabled: true
    duration: 1m
    max-attempts: 3

  nick-reservation:
    enabled: true
    method: strict
    # Guests get a Guest-* nick so they can't impersonate registered members.
    force-guest-format: true
    guest-nickname-format: "Guest-*"
    # IRC nick is always the Arcadia username.
    force-nick-equals-account: true

  multiclient:
    enabled: true
    allowed-by-default: true
    # All accounts are always-on (persistent IRC presence).
    always-on: "mandatory"
    auto-away: "mandatory"
    # Uncomment to expire always-on clients that never reconnect:
    #always-on-expiration: 90d

  # Pluggable auth: Ergo calls the Arcadia backend to validate IRC logins.
  # The token is read from $ARCADIA_ERGO__AUTH_CALLBACK_TOKEN at runtime.
  auth-script:
    enabled: true
    command: "/bin/sh"
    args:
      [
        "-c",
        'head -1 > /tmp/ergo_auth && wget -qO- --post-file=/tmp/ergo_auth --header="Content-Type: application/json" --header="Authorization: Bearer ${ARCADIA_ERGO__AUTH_CALLBACK_TOKEN}" http://backend:8080/api/auth/irc && echo',
      ]
    autocreate: true
    timeout: 9s
    kill-timeout: 1s
    max-concurrency: 64

# channel options
channels:
  default-modes: +ntC
  max-channels-per-client: 100
  # Only operators can create and register channels.
  operator-only-creation: true
  registration:
    enabled: true
    operator-only: true
    max-channels-per-account: 15

# Operator privilege levels. Two classes ship by default:
#   chat-moderator  — ban/kick/vhost/sajoin/samode and similar moderation actions
#   server-admin    — full control: rehash, account/channel registration, history deletion
# Run `/quote help capabs` on an opered connection to see all available capabilities.
oper-classes:
  "chat-moderator":
    title: Chat Moderator
    capabilities:
      - "kill"
      - "ban"
      - "nofakelag"
      - "relaymsg"
      - "vhosts"
      - "sajoin"
      - "samode"
      - "snomasks"
      - "roleplay"

  "server-admin":
    title: Server Admin
    extends: "chat-moderator"
    capabilities:
      - "rehash"
      - "accreg"
      - "chanreg"
      - "history"
      - "defcon"
      - "massmessage"
      - "metadata"

# ircd operators
opers:
  # CHANGE: replace with a real hash from `ergo genpasswd`
  admin:
    class: "server-admin"
    hidden: true
    whois-line: is the server administrator
    password: "$2a$04$0123456789abcdef0123456789abcdef0123456789abcdef01234"

  # Example moderator — uncomment and set a real password to add one:
  #alice:
  #    class: "chat-moderator"
  #    whois-line: "can help with moderation issues!"
  #    password: "$2a$04$0123456789abcdef0123456789abcdef0123456789abcdef01234"

logging:
  - method: stderr
    type: "* -userinput -useroutput"
    level: info

lock-file: "ircd.lock"

datastore:
  path: ircd.db
  autoupgrade: true
  # MySQL credentials are injected via ERGO__DATASTORE__MYSQL__* environment variables (see compose.yml)
  mysql:
    enabled: true
    timeout: 3s
    max-conns: 4

languages:
  enabled: true
  default: en
  path: /ircd-bin/languages

# History is stored persistently in MySQL.
# Adjust expire-time to match your retention/privacy policy.
history:
  enabled: true
  channel-length: 2048
  client-length: 256
  chathistory-maxmessages: 1000
  restrictions:
    expire-time: 1w
    query-cutoff: "none"
  persistent:
    enabled: true
    unregistered-channels: false
    registered-channels: "mandatory"
    direct-messages: "mandatory"
  tagmsg-storage:
    default: false
    whitelist:
      - "+draft/react"
      - "+react"

# Required: allows compose.yml to inject secrets via environment variables.
allow-environment-overrides: true

# HTTP API used by the Arcadia backend to provision IRC accounts (/v1/saregister).
# The bearer token is injected via ERGO__API__BEARER_TOKENS (see compose.yml).
api:
  enabled: true
  listener: "0.0.0.0:8089"
  # bearer-tokens:
  #   - "changeme"
