# Docker-mode backups: the repo and dumps live in this host directory, bind-mounted at the fixed path
# /var/backups/arcadia inside backup_cron. This is the only place the location is set; config.yml does
# not repeat it (backup.repo/backup.dump_dir are host mode only).
BACKUP_DIR=/var/backups/arcadia
# Host path of the restic repository password file (keep it OUTSIDE BACKUP_DIR), bind-mounted at the
# fixed path /root/.arcadia-restic-password. Likewise config.yml's backup.password_file is host mode only.
RESTIC_PASSWORD_FILE=/root/.arcadia-restic-password

# Credentials of the bundled MariaDB databases (chevereto image host, ergo IRC history).
ARCADIA_CHEVERETO_DB__NAME=chevereto
ARCADIA_CHEVERETO_DB__USER=chevereto
ARCADIA_CHEVERETO_DB__PASSWORD=arcadia
ARCADIA_ERGO_DB__NAME=ergo_history
ARCADIA_ERGO_DB__USER=ergo
ARCADIA_ERGO_DB__PASSWORD=ergo_password
