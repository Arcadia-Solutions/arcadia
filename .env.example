# Host directory holding the restic repo and dumps for docker-mode backups (backup.repo and
# backup.dump_dir must live under it; it is bind-mounted at the same path inside backup_cron).
BACKUP_DIR=/var/backups/arcadia
# Host path of the restic repository password file (keep it OUTSIDE BACKUP_DIR).
RESTIC_PASSWORD_FILE=/root/.arcadia-restic-password
